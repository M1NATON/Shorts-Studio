{
  "name": "shorts-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "studio": "node scripts/studio.mjs",
    "remotion:studio": "remotion studio packages/remotion/src/entry.tsx --port=3210",
    "e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@remotion/cli": "4.0.525",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "turbo": "^2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@shorts/contracts": "workspace:*",
    "@shorts/db": "workspace:*",
    "@shorts/llm-core": "workspace:*",
    "@shorts/media-core": "workspace:*",
    "@shorts/remotion": "workspace:*",
    "zod": "^4.6.5"
  }
}
